%{
#include <stdio.h>
#include <string.h>
#include "y.tab.h"  // Generated by bison -d
%}

%%

"int"|"float"|"return"    { return KEYWORD; }
"if"                      { return IF; }
"else"                    { return ELSE; }
"while"                   { return WHILE; }

[a-zA-Z_][a-zA-Z0-9_]*    { yylval.str = strdup(yytext); return ID; }

[0-9]+(\.[0-9]+)?         { yylval.num = atof(yytext); return NUMBER; }

"+"|"-"|"*"|"/"           { return yytext[0]; }
"=="    { return EQ; }
"!="    { return NE; }
"<="    { return LE; }
">="    { return GE; }
"<"     { return LT; }
">"     { return GT; }
"="     { return '='; }

";"|"{"|"}"|"("|")"       { return yytext[0]; }

[ \t\n]                   ;  /* Ignore whitespace */

.                         { printf("Invalid character: %s\n", yytext); }

%%

int yywrap() { return 1; }
